# Isolated downloader only; leave every other container/network untouched.
destroy table inet fishie_download
table inet fishie_download {
    chain input {
        type filter hook input priority -10; policy accept;
        iifname "fish-download" ct state established,related accept
        iifname "fish-download" reject
    }
    chain forward {
        type filter hook forward priority -10; policy accept;
        iifname "fish-download" ct state established,related accept
        iifname "fish-download" ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/3 } reject
        iifname "fish-download" meta nfproto ipv6 reject
    }
}
